{
  "manifest_version": 3,
  "name": "ZingerBurger",
  "version": "3.0.0",
  "description": "AI Webtoon Studio — Plan with Gemini, generate with Google Flow. Built by FauxGUY.",
  "permissions": ["storage", "downloads", "scripting", "tabs", "offscreen", "sidePanel"],
  "host_permissions": [
    "https://gemini.google.com/*",
    "https://labs.google/*",
    "https://flow.google/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://*.googleapis.com/*",
    "https://*.googleusercontent.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content_gemini.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    { "resources": ["lib/jszip.min.js", "assets/*"], "matches": ["<all_urls>"] }
  ]
}
